<% content_for :title, @chat.title %>

<header class="app-header app-header--rounded">
  <div class="app-header__bar">
    <%= link_to chats_path, class: "app-header__back" do %>
      <i class="fa-solid fa-chevron-left"></i>
    <% end %>
    <h1 class="app-header__title text-truncate"><%= @chat.title.truncate(30) %></h1>
    <div class="app-header__spacer"></div>
    <button type="button" class="app-header__icon" id="rename-toggle" aria-label="Renommer">
      <i class="fa-solid fa-pen"></i>
    </button>
  </div>
  <p class="app-header__sub"><%= pluralize(@chat.messages.count, "message") %> · IA</p>

  <div id="rename-form" class="mt-3" style="display:none;">
    <%= form_with model: @chat, url: rename_chat_path(@chat), method: :patch, local: true do |f| %>
      <div class="d-flex gap-2">
        <%= f.text_field :title, class: "form-control",
              style: "background:rgba(255,255,255,.95);border:0;" %>
        <%= f.submit "OK", class: "btn btn-soft", style: "padding:.6rem 1rem;" %>
      </div>
    <% end %>
  </div>
</header>

<div class="app-pad" style="margin-top:18px;">
  <div class="chat-wrap">
    <div class="chat-messages" id="messages">
      <% @chat.messages.each do |message| %>
        <% if message.role == "user" %>
          <div class="chat-bubble chat-bubble--user">
            <%= simple_format(message.content) %>
          </div>
        <% elsif message.role == "assistant" %>
          <div class="chat-bubble chat-bubble--assistant">
            <div class="chat-bubble__meta">
              <span class="chat-bubble__avatar"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
              Invoice AI
              <span class="ms-auto"><%= message.created_at.strftime("%H:%M") %></span>
            </div>
            <%= simple_format(message.content) %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @chat.messages.empty? %>
      <div class="chat-suggestions">
        <button type="button" class="suggestion-btn" data-suggestion="Analyse mes dépenses">Analyse des dépenses</button>
        <button type="button" class="suggestion-btn" data-suggestion="Quelles factures sont déductibles ?">Déductions fiscales</button>
        <button type="button" class="suggestion-btn" data-suggestion="Quelles factures arrivent bientôt à échéance ?">Factures à venir</button>
        <button type="button" class="suggestion-btn" data-suggestion="Donne-moi des conseils budgétaires">Conseils budgétaires</button>
      </div>
    <% end %>

    <div class="chat-input-bar">
      <%= form_with url: chat_messages_path(@chat), method: :post,
                    html: { id: "chat-form", class: "d-flex w-100 gap-2 align-items-end" },
                    data: { turbo: false } do %>
        <%= text_area_tag "message[content]", nil,
              placeholder: "Posez une question sur vos factures…",
              class: "form-control",
              id: "chat-input",
              rows: 1,
              style: "min-height:48px;max-height:120px;" %>
        <%= submit_tag "Envoyer", class: "btn btn-grad", id: "send-button" %>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function () {
    var renameToggle = document.getElementById('rename-toggle');
    var renameForm = document.getElementById('rename-form');
    if (renameToggle && renameForm) {
      renameToggle.addEventListener('click', function () {
        renameForm.style.display = renameForm.style.display === 'none' ? 'block' : 'none';
      });
    }

    document.querySelectorAll('.suggestion-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById('chat-input');
        if (input) { input.value = btn.dataset.suggestion; input.focus(); }
      });
    });

    var msgs = document.getElementById('messages');
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  })();
</script>
