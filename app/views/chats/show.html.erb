<!-- app/views/chats/show.html.erb -->

<div class="chat-layout">

  <div class="chat-sidebar">

  <%= button_to chats_path,
                method: :post,
                class: "btn btn-dark w-100 mb-3 rounded-pill" do %>

    + New Chat

  <% end %>

  <% @chats.each do |chat| %>

  <div class="d-flex align-items-center mb-2">

    <%= link_to chat_path(chat),
                class: "chat-sidebar-item flex-grow-1 #{'active' if chat == @chat}",
                title: chat.title do %>

      🤖 <%= chat.title %>

    <% end %>

    <%= link_to chat_path(chat),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Delete this conversation?"
                },
                class: "text-danger ms-2" do %>

      <i class="fa-solid fa-trash"></i>

    <% end %>

  </div>

<% end %>

</div>

<div class="chat-main">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold mb-1">AI Financial Assistant</h1>
      <p class="text-muted mb-0">
        Ask questions about your invoices, taxes and spending habits.
      </p>
    </div>

    <%= link_to dashboard_path, class: "btn btn-outline-dark rounded-pill px-4" do %>
      ← Dashboard
    <% end %>
  </div>


  <div class="chat-wrapper bg-white shadow-sm rounded-4 border overflow-hidden">


    <div class="chat-header p-3 border-bottom bg-light">
      <h5 class="mb-0 fw-semibold">
        <%= @chat.title %>
      </h5>
    </div>


    <div id="messages" class="messages-container p-4">

      <% @chat.messages.each do |message| %>

        <% if message.role == "user" %>


          <div class="d-flex justify-content-end mb-3">

            <div class="user-message px-4 py-3 rounded-4 shadow-sm">
              <%= simple_format(message.content) %>
            </div>

          </div>

        <% elsif message.role == "assistant" %>


          <div class="d-flex justify-content-start mb-4">

            <div class="assistant-message px-4 py-3 rounded-4 message-target">

              <div class="d-flex align-items-center mb-2">
                <div class="assistant-avatar me-2">
                  🤖
                </div>

                <strong>
                  Invoice AI
                </strong>
              </div>

              <div class="assistant-content">
                <%= simple_format(message.content) %>
              </div>

            </div>

          </div>

        <% end %>

      <% end %>

    </div>


    <div class="border-top p-3 bg-white">

          <div class="chat-suggestions mb-3">

            <button type="button"
                    class="suggestion-btn"
                    data-suggestion="Analyze my spending">
              💡 Analyze my spending
            </button>

            <button type="button"
                    class="suggestion-btn"
                    data-suggestion="Which invoices are tax deductible?">
              💰 Tax deductions
            </button>

            <button type="button"
                    class="suggestion-btn"
                    data-suggestion="What invoices are due soon?">
              📅 Upcoming invoices
            </button>

            <button type="button"
                    class="suggestion-btn"
                    data-suggestion="Give me budget recommendations">
              📊 Budget recommendations
            </button>

          </div>

      <%= simple_form_for [@chat, @message],
                            html: { id: "chat-form" } do |f| %>

        <div class="d-flex align-items-end gap-2">

          <div class="flex-grow-1">
            <%= f.input :content,
                        label: false,
                        placeholder: "Ask something about your invoices...",
                        input_html: {
                          class: "form-control rounded-4 p-3 chat-input",
                          id: "chat-input"
                        } %>
          </div>

          <div>
            <%= f.button :submit,
                         "Send",
                         class: "btn btn-dark rounded-4 px-4 py-3 fw-semibold",
                         id: "send-button" %>
          </div>

        </div>

      <% end %>

    </div>

  </div>
</div>
</div>
