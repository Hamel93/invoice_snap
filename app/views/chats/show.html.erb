<div class="container py-4">

  <div class="mb-3">

    <%= link_to chats_path,
                class: "btn btn-light rounded-circle shadow-sm" do %>

      <i class="fa-solid fa-arrow-left"></i>

    <% end %>

  </div>

  <div class="card border-0 shadow-sm rounded-4 p-3 mb-3">

    <div class="d-flex justify-content-between align-items-center">

      <div>

        <h5 class="fw-bold mb-1">
          <%= @chat.title %>
        </h5>

        <small class="text-muted">
          Conversation IA
        </small>

      </div>

      <button type="button"
              id="rename-toggle"
              class="btn btn-grad rounded-pill">

        Renommer

      </button>

    </div>

    <div id="rename-form"
         class="mt-3"
         style="display:none;">

      <%= form_with model: @chat,
                    url: rename_chat_path(@chat),
                    method: :patch,
                    local: true do |f| %>

        <div class="d-flex gap-2">

          <%= f.text_field :title,
                           class: "form-control rounded-pill" %>

          <%= f.submit "Sauvegarder",
                       class: "btn btn-grad rounded-pill" %>

        </div>

      <% end %>

    </div>

  </div>

  <div class="chat-wrapper bg-white shadow-sm rounded-4 border overflow-hidden">

    <div id="messages" class="messages-container p-4">

      <% @chat.messages.order(created_at: :asc).each do |message| %>

        <% if message.role == "user" %>

          <div class="d-flex justify-content-end mb-3">

            <div class="user-message px-4 py-3 rounded-4 shadow-sm">

              <%= simple_format(message.content) %>

            </div>

          </div>

        <% elsif message.role == "assistant" %>

          <div class="d-flex justify-content-start mb-4">

            <div class="assistant-message px-4 py-3 rounded-4 shadow-sm message-target">

              <div class="d-flex align-items-center mb-2">

                <div class="assistant-avatar me-2">
                  <i class="fa-solid fa-robot"></i>
                </div>

                <div>

                  <strong>
                    Invoice AI
                  </strong>

                  <div class="small text-muted">
                    <%= message.created_at.in_time_zone("America/Toronto").strftime("%H:%M") %>
                  </div>

                </div>

              </div>

              <div class="assistant-content">

                <%= markdown(message.content) %>

              </div>

            </div>

          </div>

        <% end %>

      <% end %>

    </div>

    <div class="chat-footer p-3">

      <div class="chat-suggestions mb-3">

        <button type="button"
                class="suggestion-btn"
                data-suggestion="Analyse mes dépenses">

          Analyse des dépenses

        </button>

        <button type="button"
                class="suggestion-btn"
                data-suggestion="Quelles factures sont déductibles ?">

          Déductions fiscales

        </button>

        <button type="button"
                class="suggestion-btn"
                data-suggestion="Quelles factures arrivent bientôt à échéance ?">

          Factures à venir

        </button>

        <button type="button"
                class="suggestion-btn"
                data-suggestion="Donne-moi des conseils budgétaires">

          Conseils budgétaires

        </button>

      </div>

      <%= simple_form_for [@chat, @message],
                          html: { id: "chat-form" } do |f| %>

        <div class="d-flex align-items-end gap-2">

          <div class="flex-grow-1">

            <%= f.input :content,
                        label: false,
                        placeholder: "Posez une question sur vos factures...",
                        input_html: {
                          class: "form-control rounded-4 p-3 chat-input",
                          id: "chat-input"
                        } %>

          </div>

          <div>

            <%= f.button :submit,
                         "Envoyer",
                         class: "btn btn-grad rounded-pill px-4 py-3 fw-semibold",
                         id: "send-button" %>

          </div>

        </div>

      <% end %>

    </div>

  </div>

</div>
