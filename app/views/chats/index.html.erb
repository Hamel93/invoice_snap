<% content_for :title, "Assistant IA" %>

<header class="app-header app-header--rounded">
  <div class="app-header__bar">
    <%= link_to dashboard_path, class: "app-header__back" do %>
      <i class="fa-solid fa-chevron-left"></i>
    <% end %>
    <h1 class="app-header__title">Assistant IA</h1>
    <div class="app-header__spacer"></div>
    <%= button_to chats_path, method: :post,
          class: "app-header__icon", "aria-label": "Nouvelle conversation",
          data: { turbo: false } do %>
      <i class="fa-solid fa-plus"></i>
    <% end %>
  </div>
  <p class="app-header__sub">Analysez vos factures et obtenez des conseils personnalisés.</p>
</header>

<div class="app-pad" style="margin-top:18px;">
  <% if @chats.any? %>
    <div class="section-eyebrow mb-2">Conversations</div>
    <% @chats.each do |chat| %>
      <div class="chat-list-item">
        <div class="chat-list-item__icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
        <%= link_to chat_path(chat), class: "chat-list-item__body text-decoration-none" do %>
          <div class="chat-list-item__title text-truncate"><%= chat.title.truncate(48) %></div>
          <div class="chat-list-item__sub"><%= pluralize(chat.messages.count, "message") %></div>
        <% end %>
        <%= link_to chat_path(chat),
              data: { turbo_method: :delete, turbo_confirm: "Supprimer cette conversation ?" },
              class: "chat-list-item__del", "aria-label": "Supprimer" do %>
          <i class="fa-solid fa-trash"></i>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state card-soft">
      <i class="fa-solid fa-wand-magic-sparkles d-block"></i>
      <div class="empty-state__title">Aucune conversation</div>
      <div class="empty-state__sub">Commencez votre première analyse financière avec l'IA.</div>
      <%= button_to chats_path, method: :post, class: "btn btn-grad", data: { turbo: false } do %>
        <i class="fa-solid fa-plus me-2"></i>Nouvelle conversation
      <% end %>
    </div>
  <% end %>
</div>
