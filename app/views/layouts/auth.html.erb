<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Invoice Snap" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Invoice Snap">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0d0a3e">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="theme-color" content="#4039d4">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Invoice Snap">
    <link rel="apple-touch-icon" href="<%= image_path 'icons/apple-icon-180x180.png' %>">
    <link rel="manifest" href="<%= asset_path 'manifest.json' %>">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= image_path 'icons/favicon-32x32.png' %>">
    <link rel="icon" type="image/png" sizes="96x96" href="<%= image_path 'icons/favicon-96x96.png' %>">
</head>

  <body>
    <div class="app-wrap">
      <div class="flash-stack"><%= render "shared/flashes" %></div>
      <main class="app-main app-main--flush"><%= yield %></main>
    </div>
  </body>
</html>
