<% content_for :title, "Invoice Snap — Scannez. Classez. Relancez." %>

<section class="auth-hero">
  <div class="d-flex align-items-center gap-2 mb-5">
    <div class="auth-logo">IS</div>
    <span class="fw-bold fs-5">Invoice Snap</span>
  </div>

  <p class="mb-2" style="font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#c9c5fa;">
    Pour freelances &amp; TPE
  </p>

  <h1 style="font-size:2.2rem;font-weight:800;line-height:1.1;letter-spacing:-.028em;margin:0;color:#fff;">
    Scannez, classez,<br>relancez. Sans effort.
  </h1>

  <p class="mt-3 mb-0" style="color:#c9c5fa;font-size:.95rem;line-height:1.5;">
    Invoice Snap transforme vos factures en données exploitables en quelques secondes.
  </p>
</section>

<section class="app-pad" style="margin-top:-30px;position:relative;z-index:2;">
  <div class="card-soft">
    <div class="promise mb-3">
      <div class="promise__icon" style="background:#eceafe;color:#4039d4;">
        <i class="fa-solid fa-bolt"></i>
      </div>
      <div>
        <div class="fw-bold" style="font-size:.92rem;">Scannez en quelques secondes</div>
        <div class="faint" style="font-size:.78rem;">L'OCR extrait montants, dates et clients.</div>
      </div>
    </div>

    <div class="divider-soft my-3"></div>

    <div class="promise mb-3">
      <div class="promise__icon" style="background:#dcfce7;color:#16a34a;">
        <i class="fa-solid fa-folder-tree"></i>
      </div>
      <div>
        <div class="fw-bold" style="font-size:.92rem;">Classement automatique</div>
        <div class="faint" style="font-size:.78rem;">Vos documents triés dans les bons classeurs.</div>
      </div>
    </div>

    <div class="divider-soft my-3"></div>

    <div class="promise">
      <div class="promise__icon" style="background:#fef3c7;color:#d97706;">
        <i class="fa-solid fa-bell"></i>
      </div>
      <div>
        <div class="fw-bold" style="font-size:.92rem;">Zéro facture oubliée</div>
        <div class="faint" style="font-size:.78rem;">Calendrier et rappels d'échéance intégrés.</div>
      </div>
    </div>
  </div>

  <div class="d-grid gap-2 mt-4">
    <%= link_to "Créer un compte", new_user_registration_path,
          class: "btn btn-grad btn-lg btn-block", data: { turbo: false } %>
    <%= link_to "J'ai déjà un compte", new_user_session_path,
          class: "btn btn-ghost btn-block", data: { turbo: false } %>
  </div>

  <p class="text-center faint mt-3 mb-4" style="font-size:.74rem;font-weight:500;">
    Sans carte bancaire · 14 jours d'essai
  </p>
</section>
