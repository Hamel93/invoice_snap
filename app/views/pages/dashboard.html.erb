<div class="container py-4">

  <h1 class="mb-4">Dashboard</h1>

  <div class="row mb-4">

    <div class="col-md-3 mb-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Total factures</h6>
          <h2><%= @total_invoices %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Total dû</h6>
          <h2>$<%= @total_due %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Factures en retard</h6>
          <h2><%= @overdue_invoices.count %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Échéances proches</h6>
          <h2><%= @upcoming_invoices.count %></h2>
        </div>
      </div>
    </div>

  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Dernières factures</h4>

        <%= link_to "Voir toutes les factures", invoices_path, class: "btn btn-dark btn-sm" %>
      </div>

      <% if @invoices.any? %>

        <div class="table-responsive">
          <table class="table">

            <thead>
              <tr>
                <th>Entreprise</th>
                <th>Montant</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>

            <tbody>
              <% @invoices.limit(5).each do |invoice| %>
                <tr>
                  <td><%= invoice.company_name %></td>
                  <td>$<%= invoice.amount %></td>
                  <td><%= invoice.status %></td>

                  <td>
                    <%= link_to "Voir", invoice_path(invoice), class: "btn btn-sm btn-outline-dark" %>
                  </td>
                </tr>
              <% end %>
            </tbody>

          </table>
        </div>

      <% else %>

        <p>Aucune facture disponible.</p>

      <% end %>

    </div>
  </div>

</div>
