<% content_for :title, "Tableau de bord" %>
<%
  invoices    = @invoices.to_a
  name        = current_user.email.split("@").first.capitalize
  total_count = invoices.size
  paid        = invoices.select { |i| i.status.to_s.downcase.in?(%w[paid payee accepted]) }
  pending     = invoices.select { |i| i.status.to_s.downcase == "pending" }
  overdue_inv = invoices.select { |i| i.status.to_s.downcase == "overdue" }
  ca          = paid.sum { |i| i.amount.to_f }
  pending_amt = pending.sum { |i| i.amount.to_f }
  clients     = invoices.map(&:company_name).compact_blank.uniq.size
  overdue     = overdue_inv.size
  recouvrement = total_count.positive? ? (paid.size * 100 / total_count) : 0

  months  = (0..5).map { |n| Date.today.beginning_of_month - n.months }.reverse
  monthly = months.map { |m| [ApplicationHelper::FR_MONTHS_SHORT[m.month],
              paid.select { |i| i.created_at.to_date >= m && i.created_at.to_date <= m.end_of_month }.sum { |i| i.amount.to_f }] }
  maxv = [monthly.map { |_, v| v }.max.to_f, 1].max

  notif_count = overdue + @reminders.count { |r| r.reminder_date && !r.sent && r.reminder_date >= Date.today }
%>

<header class="app-header app-header--rounded app-header--pull">
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <div style="font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#c9c5fa;">
        <%= fr_date %>
      </div>
      <div style="font-size:1.6rem;font-weight:700;letter-spacing:-.025em;margin-top:6px;color:#fff;">
        Bonjour, <%= name %>.
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <%= link_to notifications_path, class: "app-header__bell", "aria-label": "Notifications" do %>
        <i class="fa-regular fa-bell"></i>
        <% if notif_count.positive? %>
          <span class="app-header__bell-dot app-header__bell-dot--count"><%= notif_count > 9 ? "9+" : notif_count %></span>
        <% end %>
      <% end %>
      <%= link_to initials(name), profile_path, class: "app-header__avatar" %>
    </div>
  </div>
</header>

<div class="app-pad">
  <div class="card-soft card-overlap">
    <div class="stat-strip">
      <div class="stat-strip__col">
        <div class="stat-strip__num font-mono"><%= total_count %></div>
        <div class="stat-strip__lbl">Factures</div>
      </div>
      <div class="stat-strip__col">
        <div class="stat-strip__num font-mono"><%= eur(ca) %></div>
        <div class="stat-strip__lbl">Encaissé</div>
      </div>
      <div class="stat-strip__col">
        <div class="stat-strip__num font-mono"><%= clients %></div>
        <div class="stat-strip__lbl">Clients</div>
      </div>
    </div>
  </div>

  <% if overdue.positive? %>
    <div class="alert-soft alert-soft--danger section-gap">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div><strong><%= pluralize(overdue, "facture") %> en retard</strong> — pensez à envoyer vos relances.</div>
    </div>
  <% end %>

  <div class="d-flex justify-content-between align-items-center section-gap mb-2">
    <div>
      <div class="section-eyebrow">Raccourcis</div>
      <h2 class="section-title">Que faire aujourd'hui ?</h2>
    </div>
  </div>

  <div class="bento">
    <%= link_to camera_invoices_path, class: "bento__tile bento__tile--span2 bento__tile--primary bento__tile--tall" do %>
      <div class="bento__tile__icon"><i class="fa-solid fa-camera"></i></div>
      <div class="bento__tile__lbl">Nouveau</div>
      <div class="bento__tile__num" style="font-size:1.4rem;">Scanner<br>une facture</div>
      <div class="bento__tile__sub" style="margin-top:4px;">OCR automatique</div>
    <% end %>

    <%= link_to invoices_path, class: "bento__tile bento__tile--span2" do %>
      <div class="bento__tile__icon" style="background:#fef3c7;color:#d97706;"><i class="fa-regular fa-folder-open"></i></div>
      <div class="bento__tile__lbl">En attente</div>
      <div class="bento__tile__num font-mono"><%= eur(pending_amt) %></div>
      <div class="bento__tile__sub"><%= pending.size %> facture<%= "s" if pending.size > 1 %></div>
    <% end %>

    <%= link_to reminders_path, class: "bento__tile bento__tile--span2" do %>
      <div class="bento__tile__icon" style="background:#eceafe;color:#4039d4;"><i class="fa-regular fa-calendar"></i></div>
      <div class="bento__tile__lbl">Échéances</div>
      <div class="bento__tile__num font-mono"><%= @reminders.count { |r| r.reminder_date && r.reminder_date >= Date.today } %></div>
      <div class="bento__tile__sub">à venir</div>
    <% end %>

    <%= link_to chats_path, class: "bento__tile bento__tile--span2" do %>
      <div class="bento__tile__icon" style="background:#dcfce7;color:#16a34a;"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
      <div class="bento__tile__lbl">Assistant IA</div>
      <div class="bento__tile__num" style="font-size:1.2rem;">Analyser<br>mes dépenses</div>
    <% end %>

    <%= link_to folders_path, class: "bento__tile bento__tile--span2" do %>
      <div class="bento__tile__icon" style="background:#fee2e2;color:#dc2626;"><i class="fa-solid fa-folder"></i></div>
      <div class="bento__tile__lbl">Classeurs</div>
      <div class="bento__tile__num font-mono"><%= @folders.count %></div>
      <div class="bento__tile__sub">tous les dossiers</div>
    <% end %>
  </div>

  <div class="d-flex justify-content-between align-items-center section-gap mb-2">
    <div>
      <div class="section-eyebrow">Récentes</div>
      <h2 class="section-title">Dernières factures</h2>
    </div>
    <%= link_to "Voir tout", invoices_path, class: "link-more" %>
  </div>

  <% if invoices.any? %>
    <% invoices.first(4).each do |invoice| %>
      <%= render "shared/invoice_row", invoice: invoice %>
    <% end %>
  <% else %>
    <div class="empty-state card-soft">
      <i class="fa-regular fa-file-lines d-block"></i>
      <div class="empty-state__title">Aucune facture pour l'instant</div>
      <div class="empty-state__sub">Commencez par scanner votre premier document.</div>
      <%= link_to "Scanner ma première facture", camera_invoices_path, class: "btn btn-grad" %>
    </div>
  <% end %>

  <% if invoices.any? %>
    <div class="section-gap">
      <div class="section-eyebrow">Tendance</div>
      <div class="card-soft">
        <div class="d-flex justify-content-between align-items-end mb-3">
          <div>
            <div class="section-title">Revenus sur 6 mois</div>
            <div class="muted font-mono" style="font-size:.78rem;margin-top:2px;">
              <%= eur(monthly.sum { |_, v| v }) %> encaissés
            </div>
          </div>
          <div class="badge-status paid"><%= recouvrement %>% recouvrement</div>
        </div>

        <div class="bars">
          <% monthly.each do |label, val| %>
            <div class="bars__bar <%= 'is-hi' if val == maxv && maxv > 1 %>"
                 style="height:<%= [(val / maxv * 140).round, 6].max %>px;"
                 title="<%= label %> · <%= eur(val) %>"></div>
          <% end %>
        </div>
        <div class="d-flex mt-2">
          <% monthly.each do |label, _| %>
            <div class="bars__lbl"><%= label %></div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
