<% content_for :title, "Profil" %>
<%
  name     = current_user.email.split("@").first.capitalize
  invoices = current_user.invoices.to_a
  ca       = invoices.select { |i| i.status.to_s.downcase == "paid" }.sum { |i| i.amount.to_f }
  clients  = invoices.map(&:company_name).compact_blank.uniq.size
%>

<header class="app-header app-header--rounded app-header--pull text-center">
  <div class="avatar-initial avatar-initial--lg mx-auto" style="background:rgba(255,255,255,.2);color:#fff;">
    <%= initials(name) %>
  </div>
  <div class="mt-3" style="font-size:1.35rem;font-weight:700;letter-spacing:-.022em;color:#fff;"><%= name %></div>
  <div class="app-header__sub mt-1" style="font-size:.82rem;">
    <%= current_user.email %>
  </div>
</header>

<div class="app-pad">
  <div class="card-soft card-overlap">
    <div class="stat-strip">
      <div class="stat-strip__col">
        <div class="stat-strip__num font-mono"><%= invoices.size %></div>
        <div class="stat-strip__lbl">Factures</div>
      </div>
      <div class="stat-strip__col">
        <div class="stat-strip__num font-mono"><%= eur(ca) %></div>
        <div class="stat-strip__lbl">Encaissé</div>
      </div>
      <div class="stat-strip__col">
        <div class="stat-strip__num font-mono"><%= clients %></div>
        <div class="stat-strip__lbl">Clients</div>
      </div>
    </div>
  </div>

  <div class="card-soft section-gap p-0" style="overflow:hidden;">
    <% menu = [
      ["fa-user-gear",     "Mon compte",       edit_user_registration_path],
      ["fa-bell",          "Notifications",    notifications_path],
      ["fa-wand-magic-sparkles", "Assistant IA", chats_path]
    ] %>
    <% menu.each_with_index do |(icon, label, url), i| %>
      <%= link_to url, class: "d-flex align-items-center gap-3 text-decoration-none text-dark px-3 py-3" do %>
        <span class="avatar-initial" style="width:38px;height:38px;border-radius:12px;background:#eceafe;color:#4039d4;">
          <i class="fa-solid <%= icon %>"></i>
        </span>
        <span class="flex-fill fw-semibold" style="font-size:.9rem;"><%= label %></span>
        <i class="fa-solid fa-chevron-right faint" style="font-size:.78rem;"></i>
      <% end %>
      <% unless i == menu.size - 1 %><div class="divider-soft" style="margin:0 16px;"></div><% end %>
    <% end %>
  </div>

  <%= button_to destroy_user_session_path, method: :delete,
        class: "btn btn-danger-soft w-100 mt-3" do %>
    <i class="fa-solid fa-right-from-bracket me-2"></i>Se déconnecter
  <% end %>
  <p class="text-center faint mt-3 mb-4" style="font-size:.74rem;font-weight:500;">
    Invoice Snap · v1.0
  </p>
</div>
