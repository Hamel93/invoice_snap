<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @folder.name %></h1>
    <%= link_to "Retour", folders_path, class: "btn btn-outline-secondary" %>
  </div>

  <% if @invoices.any? %>
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="mb-3">Factures dans ce dossier</h5>

        <table class="table">
          <thead>
            <tr>
              <th>Entreprise</th>
              <th>Montant</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @invoices.each do |invoice| %>
              <tr>
                <td><%= invoice.company_name %></td>
                <td>$<%= invoice.amount %></td>
                <td><%= invoice.status %></td>
                <td><%= link_to "Voir", invoice_path(invoice), class: "btn btn-sm btn-outline-dark" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info">Aucune facture dans ce dossier.</div>
  <% end %>
</div>
