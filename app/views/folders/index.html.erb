<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Dossiers</h1>
    <%= link_to "Nouveau dossier", new_folder_path, class: "btn btn-primary" %>
  </div>

  <% if @folders.any? %>
    <div class="row">
      <% @folders.each do |folder| %>
        <div class="col-md-4 mb-3">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5><%= folder.name %></h5>
              <p class="text-muted"><%= folder.invoices.count %> facture(s)</p>
              <%= link_to "Voir", folder_path(folder), class: "btn btn-dark btn-sm" %>
              <%= link_to "Modifier", edit_folder_path(folder), class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">Aucun dossier pour le moment.</div>
  <% end %>
</div>
