<% content_for :title, "Classeurs" %>

<% selected_filter = params[:filter].presence || "Tout" %>
<% filters = ["Tout", "Factures", "Reçus", "Contrats", "Devis"] %>

<% folders_scope =
  if selected_filter == "Tout"
    @folders
  else
    @folders.select { |folder| folder.name.to_s.downcase == selected_filter.downcase }
  end
%>

<% total_docs = @folders.sum { |f| f.invoices.count } %>

<header class="app-header app-header--rounded">
  <div class="app-header__bar">
    <h1 class="app-header__title">Mes Classeurs</h1>
    <div class="app-header__spacer"></div>
    <%= link_to new_folder_path, class: "app-header__icon" do %>
      <i class="fa-solid fa-plus"></i>
    <% end %>
  </div>

  <p class="app-header__sub">
    <%= total_docs %> documents · classés automatiquement
  </p>
</header>

<div class="app-pad" style="margin-top:18px;">
  <div class="folder-tabs">
    <% filters.each do |filter| %>
      <%= link_to filter,
            folders_path(filter: filter),
            class: "folder-tab #{'is-active' if selected_filter == filter}" %>
    <% end %>
  </div>

  <% colors = [
    ["#eceafe", "#4039d4", "fa-folder"],
    ["#dcfce7", "#16a34a", "fa-receipt"],
    ["#fef3c7", "#d97706", "fa-file-contract"],
    ["#eceafe", "#5b51e8", "fa-file-lines"],
    ["#fee2e2", "#dc2626", "fa-box-archive"]
  ] %>

  <div class="row g-3 mt-1">
    <% folders_scope.each_with_index do |folder, i| %>
      <% c = colors[i % colors.size] %>

      <div class="col-6">
        <%= link_to folder_path(folder), class: "folder-card" do %>
          <div class="folder-card__icon" style="background:<%= c[0] %>;color:<%= c[1] %>;">
            <i class="fa-solid <%= c[2] %>"></i>
          </div>

          <div class="folder-card__name text-truncate">
            <%= folder.name %>
          </div>

          <div class="folder-card__count">
            <%= pluralize(folder.invoices.count, "document") %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="col-6">
      <%= link_to new_folder_path,
            class: "folder-card d-flex flex-column align-items-center justify-content-center text-center folder-card--new" do %>
        <i class="fa-solid fa-plus mb-2"></i>
        <span>Nouveau classeur</span>
      <% end %>
    </div>
  </div>
</div>
