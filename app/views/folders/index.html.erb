<% content_for :title, "Classeurs" %>
<%
  total_docs = @folders.sum { |f| f.invoices.count }
%>

<header class="app-header app-header--rounded">
  <div class="app-header__bar">
    <h1 class="app-header__title">Classeurs</h1>
    <div class="app-header__spacer"></div>
    <button type="button" class="app-header__icon"
            data-bs-toggle="modal" data-bs-target="#folderModal"
            data-folder-action="new"
            aria-label="Nouveau classeur">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>

  <p class="app-header__sub">
    <%= pluralize(@folders.size, "classeur") %> · <%= pluralize(total_docs, "document") %>
  </p>
</header>

<div class="app-pad" style="margin-top:18px;">
  <% colors = [
    ["#eceafe", "#4039d4", "fa-folder"],
    ["#dcfce7", "#16a34a", "fa-receipt"],
    ["#fef3c7", "#d97706", "fa-file-contract"],
    ["#eceafe", "#5b51e8", "fa-file-lines"],
    ["#fee2e2", "#dc2626", "fa-box-archive"]
  ] %>

  <% if @folders.any? %>
    <div class="row g-3 mt-1">
      <% @folders.each_with_index do |folder, i| %>
        <% c = colors[i % colors.size] %>
        <div class="col-6">
          <%= link_to folder_path(folder), class: "folder-card" do %>
            <div class="folder-card__icon" style="background:<%= c[0] %>;color:<%= c[1] %>;">
              <i class="fa-solid <%= c[2] %>"></i>
            </div>
            <div class="folder-card__name text-truncate"><%= folder.name %></div>
            <div class="folder-card__count font-mono"><%= pluralize(folder.invoices.count, "document") %></div>
          <% end %>
        </div>
      <% end %>

      <div class="col-6">
        <button type="button" class="folder-card folder-card--new w-100"
                data-bs-toggle="modal" data-bs-target="#folderModal"
                data-folder-action="new"
                style="border-style:dashed;background:rgba(255,255,255,.5);">
          <i class="fa-solid fa-plus"></i>
          <span>Nouveau classeur</span>
        </button>
      </div>
    </div>
  <% else %>
    <div class="empty-state card-soft">
      <i class="fa-regular fa-folder-open d-block"></i>
      <div class="empty-state__title">Aucun classeur</div>
      <div class="empty-state__sub">Créez votre premier classeur pour organiser vos factures.</div>
      <button type="button" class="btn btn-grad"
              data-bs-toggle="modal" data-bs-target="#folderModal">
        <i class="fa-solid fa-plus me-2"></i>Créer un classeur
      </button>
    </div>
  <% end %>
</div>

<%# Modale création de classeur %>
<div class="modal fade" id="folderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered px-3">
    <div class="modal-content">
      <div class="modal-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="section-eyebrow mb-0">Classeur</div>
            <h2 class="section-title mt-1">Nouveau classeur</h2>
          </div>
          <button type="button" class="sheet__close" data-bs-dismiss="modal" aria-label="Fermer">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <%= form_with model: Folder.new, url: folders_path, data: { turbo: false } do |f| %>
          <div class="mb-3">
            <%= f.label :name, "Nom du classeur", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "ex. Factures 2025", autofocus: true, required: true %>
          </div>
          <%= f.submit "Créer le classeur", class: "btn btn-grad w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
