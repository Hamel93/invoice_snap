<div class="container py-4">
  <h1 class="mb-4">Modifier le dossier</h1>

  <%= render "shared/form_errors", object: @folder %>

  <%= form_with model: @folder, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :name, "Nom du dossier", class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <%= f.submit "Mettre à jour", class: "btn btn-primary" %>
    <%= link_to "Retour", folders_path, class: "btn btn-outline-secondary" %>
  <% end %>
</div>
