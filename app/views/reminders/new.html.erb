<div class="container py-4">
  <h1 class="mb-4">Nouveau rappel</h1>

  <%= render "shared/form_errors", object: @reminder %>

  <%= form_with model: @reminder, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :invoice_id, "Facture", class: "form-label" %>
      <%= f.collection_select :invoice_id, @invoices, :id, :company_name, {}, class: "form-select" %>
    </div>

    <div class="mb-3">
      <%= f.label :reminder_date, "Date du rappel", class: "form-label" %>
      <%= f.date_field :reminder_date, class: "form-control" %>
    </div>

    <div class="form-check mb-3">
      <%= f.check_box :sent, class: "form-check-input" %>
      <%= f.label :sent, "Déjà envoyé", class: "form-check-label" %>
    </div>

    <%= f.submit "Créer le rappel", class: "btn btn-primary" %>
    <%= link_to "Retour", reminders_path, class: "btn btn-outline-secondary" %>
  <% end %>
</div>
