<% content_for :title, "Rappel" %>

<%= render "shared/screen_header", title: "Rappel d'échéance", back: reminders_path %>

<div class="app-pad" style="margin-top:18px;">
  <div class="card-soft">
    <div class="d-flex justify-content-between mb-2"><span class="muted">Facture</span>
      <span class="fw-semibold"><%= @reminder.invoice.company_name %> · <%= @reminder.invoice.invoice_number %></span></div>
    <div class="d-flex justify-content-between mb-2"><span class="muted">Date</span>
      <span class="fw-semibold"><%= short_date(@reminder.reminder_date) %></span></div>
    <div class="d-flex justify-content-between"><span class="muted">Statut</span>
      <span class="badge-status <%= @reminder.sent ? 'paid' : 'pending' %>"><%= @reminder.sent ? "Envoyé" : "Programmé" %></span></div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <%= link_to "Voir la facture", invoice_path(@reminder.invoice), class: "btn btn-ghost flex-fill" %>
    <%= link_to "Modifier", edit_reminder_path(@reminder), class: "btn btn-soft flex-fill" %>
  </div>
</div>
