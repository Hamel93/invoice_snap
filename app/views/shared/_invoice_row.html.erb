<%# locals: invoice: %>
<%= link_to invoice_path(invoice), class: "list-row" do %>
  <div class="avatar-initial <%= avatar_color_for(invoice.company_name) %>"><%= initials(invoice.company_name) %></div>
  <div class="list-row__body">
    <div class="list-row__title text-truncate"><%= invoice.company_name.presence || "Document" %></div>
    <div class="list-row__sub">
      <%= [invoice.invoice_number.presence, short_date(invoice.due_date || invoice.created_at)].compact.join(" · ") %>
    </div>
  </div>
  <div class="text-end">
    <div class="list-row__amount"><%= eur(invoice.amount) %></div>
    <% if invoice.status.present? %><div class="mt-1"><%= status_badge(invoice.status) %></div><% end %>
  </div>
<% end %>
