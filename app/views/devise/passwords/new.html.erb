<% content_for :title, "Mot de passe oublié" %>

<section class="auth-hero" style="padding-bottom:42px;">
  <%= link_to new_user_session_path, class: "app-header__back d-inline-flex mb-4" do %>
    <i class="fa-solid fa-chevron-left"></i>
  <% end %>
  <h1 style="font-size:1.7rem;font-weight:800;">Mot de passe oublié ?</h1>
  <p class="mb-0" style="color:#c9c5fa;">On vous envoie un lien de réinitialisation.</p>
</section>

<section class="app-pad" style="margin-top:-26px;position:relative;z-index:2;">
  <div class="card-soft">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <div class="mb-4">
        <%= f.label :email, "Adresse e-mail", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "vous@email.fr", class: "form-control" %>
      </div>
      <%= f.submit "Envoyer le lien", class: "btn btn-grad w-100" %>
    <% end %>
  </div>
  <p class="text-center muted mt-4" style="font-size:.86rem;">
    <%= link_to "Retour à la connexion", new_user_session_path, class: "fw-semibold" %>
  </p>
</section>
