<% content_for :title, "Mon profil" %>

<%= render "shared/screen_header", title: "Mon profil", subtitle: "Modifiez vos informations de compte", back: profile_path %>

<div class="app-pad" style="margin-top:18px;">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, class: "card-soft") do |f| %>
    <% if resource.errors.any? %>
      <div class="alert alert-danger py-2" style="font-size:.82rem;"><%= resource.errors.full_messages.first %></div>
    <% end %>

    <div class="mb-3">
      <%= f.label :email, "Adresse e-mail", class: "form-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :password, "Nouveau mot de passe", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "new-password",
            placeholder: "laisser vide pour ne pas changer", class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
    </div>

    <div class="mb-4">
      <%= f.label :current_password, "Mot de passe actuel", class: "form-label" %>
      <%= f.password_field :current_password, autocomplete: "current-password",
            placeholder: "requis pour confirmer", class: "form-control" %>
    </div>

    <%= f.submit "Enregistrer", class: "btn btn-grad w-100" %>
  <% end %>

  <%= button_to "Supprimer mon compte", registration_path(resource_name), method: :delete,
        class: "btn w-100 mt-3", style: "background:#fee2e2;color:#dc2626;font-weight:600;",
        data: { turbo_confirm: "Supprimer définitivement votre compte ?" } %>
</div>
