<% content_for :title, "Créer un compte" %>

<section class="auth-hero" style="padding-bottom:44px;">
  <%= link_to root_path, class: "app-header__back d-inline-flex mb-4" do %>
    <i class="fa-solid fa-chevron-left"></i>
  <% end %>
  <p class="mb-2" style="font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#c9c5fa;">
    14 jours d'essai
  </p>
  <h1 style="font-size:1.9rem;font-weight:800;letter-spacing:-.028em;margin:0;color:#fff;">Créer votre<br>compte.</h1>
  <p class="mt-3 mb-0" style="color:#c9c5fa;">Commencez gratuitement en moins d'une minute.</p>
</section>

<section class="app-pad" style="margin-top:-30px;position:relative;z-index:2;">
  <div class="card-soft">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <% if resource.errors.any? %>
        <div class="alert alert-danger py-2" style="font-size:.82rem;border-radius:14px;">
          <%= resource.errors.full_messages.first %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :email, "Adresse e-mail", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "vous@email.fr", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Mot de passe", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password",
              placeholder: "8 caractères minimum", class: "form-control" %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              placeholder: "••••••••", class: "form-control" %>
      </div>

      <%= f.submit "Créer mon compte →", class: "btn btn-grad btn-lg w-100" %>
    <% end %>
  </div>

  <p class="text-center muted mt-4 mb-4" style="font-size:.86rem;">
    Déjà un compte ?
    <%= link_to "Se connecter", new_user_session_path,
          style: "color:#4039d4;font-weight:600;text-decoration:none;" %>
  </p>
</section>
