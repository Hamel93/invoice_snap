<% content_for :title, "Connexion" %>

<section class="auth-hero" style="padding-bottom:44px;">
  <%= link_to root_path, class: "app-header__back d-inline-flex mb-4" do %>
    <i class="fa-solid fa-chevron-left"></i>
  <% end %>
  <p class="mb-2" style="font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#c9c5fa;">
    Bon retour
  </p>
  <h1 style="font-size:1.9rem;font-weight:800;letter-spacing:-.028em;margin:0;color:#fff;">Reprenez là où<br>vous en étiez.</h1>
  <p class="mt-3 mb-0" style="color:#c9c5fa;">Connectez-vous à votre espace Invoice Snap.</p>
</section>

<section class="app-pad" style="margin-top:-30px;position:relative;z-index:2;">
  <div class="card-soft">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :email, "Adresse e-mail", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "vous@email.fr", class: "form-control" %>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <%= f.label :password, "Mot de passe", class: "form-label mb-0" %>
          <%= link_to "Oublié ?", new_user_password_path,
                style: "font-size:.74rem;font-weight:600;color:#4039d4;text-decoration:none;" %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password",
              placeholder: "••••••••", class: "form-control" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-3">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Se souvenir de moi", class: "form-check-label" %>
        </div>
      <% end %>

      <%= f.submit "Se connecter", class: "btn btn-grad btn-lg w-100" %>
    <% end %>
  </div>

  <p class="text-center muted mt-4 mb-4" style="font-size:.86rem;">
    Pas encore de compte ?
    <%= link_to "Créer un compte", new_user_registration_path,
          style: "color:#4039d4;font-weight:600;text-decoration:none;" %>
  </p>
</section>
