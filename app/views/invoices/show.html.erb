<% content_for :title, "Facture #{@invoice.invoice_number}" %>
<% amount = @invoice.amount.to_f %>
<% ht = (amount / 1.2).round(2) %>

<header class="app-header app-header--pull">
  <div class="app-header__bar">
    <%= link_to invoices_path, class: "app-header__back" do %><i class="fa-solid fa-chevron-left"></i><% end %>
    <span class="fw-semibold"><%= @invoice.invoice_number.presence || "Facture" %></span>
    <div class="app-header__spacer"></div>
    <%= link_to edit_invoice_path(@invoice), class: "app-header__icon" do %><i class="fa-solid fa-pen"></i><% end %>
  </div>
  <div class="app-header__big"><%= eur(@invoice.amount) %></div>
  <div class="mt-2 d-flex align-items-center gap-2">
    <%= status_badge(@invoice.status) %>
    <% if @invoice.due_date %><span style="color:#c9c5fa;font-size:.8rem;">échéance le <%= short_date(@invoice.due_date) %></span><% end %>
  </div>
</header>

<div class="app-pad" style="margin-top:18px;">
  <div class="d-grid gap-2 mb-1">
    <% unless @invoice.status.to_s.downcase == "paid" %>
      <%= button_to invoice_path(@invoice), method: :patch, params: { invoice: { status: "paid" } }, class: "btn btn-grad" do %>
        <i class="fa-solid fa-circle-check me-2"></i>Marquer comme payée
      <% end %>
    <% end %>
    <div class="d-flex gap-2">
      <% if @invoice.document.attached? %>
        <%= link_to rails_blob_path(@invoice.document, disposition: "attachment"), class: "btn btn-ghost flex-fill" do %>
          <i class="fa-solid fa-download me-2"></i>PDF
        <% end %>
      <% end %>
      <%= link_to edit_invoice_path(@invoice), class: "btn btn-ghost flex-fill" do %>
        <i class="fa-solid fa-pen me-2"></i>Modifier
      <% end %>
    </div>
  </div>

  <div class="card-soft section-gap">
    <h2 class="section-title mb-3">Informations</h2>
    <div class="row g-3">
      <div class="col-6"><div class="kv__lbl">Client</div><div class="kv__val"><%= @invoice.company_name.presence || "—" %></div></div>
      <div class="col-6"><div class="kv__lbl">N° de facture</div><div class="kv__val"><%= @invoice.invoice_number.presence || "—" %></div></div>
      <div class="col-6"><div class="kv__lbl">Catégorie</div><div class="kv__val"><%= @invoice.category.presence || "—" %></div></div>
      <div class="col-6"><div class="kv__lbl">Échéance</div><div class="kv__val"><%= @invoice.due_date ? short_date(@invoice.due_date) : "—" %></div></div>
    </div>
  </div>

  <% amount = @invoice.amount.to_f %>
<% subtotal = (amount / 1.14975).round(2) %>
<% tps = (subtotal * 0.05).round(2) %>
<% tvq = (subtotal * 0.09975).round(2) %>

<div class="card-soft section-gap">
    <h2 class="section-title mb-3">Montants</h2>
    <div class="d-flex justify-content-between mb-2"><span class="muted">Montant avant taxes</span><span class="fw-semibold"><%= eur(subtotal) %></span></div>
    <div class="d-flex justify-content-between mb-2"><span class="muted">TPS (5 %)</span><span class="fw-semibold"><%= eur(tps) %></span></div>
    <div class="d-flex justify-content-between mb-2"><span class="muted">TVQ (9.975 %)</span><span class="fw-semibold"><%= eur(tvq) %></span></div>
    <div class="divider-soft my-2"></div>
    <div class="d-flex justify-content-between"><span class="fw-bold">Total</span><span class="fw-bold" style="color:#4039d4;"><%= eur(@invoice.amount) %></span></div>
  </div>

  <% if @invoice.reminders.any? %>
    <div class="card-soft section-gap">
      <h2 class="section-title mb-3">Rappels &amp; échéances</h2>
      <% @invoice.reminders.order(:reminder_date).each do |reminder| %>
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span><i class="fa-regular fa-clock me-2 faint"></i><%= short_date(reminder.reminder_date) %></span>
          <span class="badge-status <%= reminder.sent ? 'paid' : 'pending' %>"><%= reminder.sent ? "Envoyé" : "Programmé" %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @invoice.folders.any? %>
    <div class="mt-3 d-flex flex-wrap gap-2">
      <% @invoice.folders.each do |folder| %>
        <span class="chip"><i class="fa-solid fa-folder me-1"></i><%= folder.name %></span>
      <% end %>
    </div>
  <% end %>

  <%= button_to invoice_path(@invoice), method: :delete,
        class: "btn w-100 mt-3", style: "background:#fee2e2;color:#dc2626;font-weight:600;" do %>
    <i class="fa-solid fa-trash me-2"></i>Supprimer la facture
  <% end %>
</div>

<%= render "shared/delete_invoice_modal", invoice: @invoice %>
