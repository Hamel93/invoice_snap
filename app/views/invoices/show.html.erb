<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @invoice.company_name %></h1>

    <div>
      <%= link_to "Modifier", edit_invoice_path(@invoice), class: "btn btn-outline-dark" %>

      <%= link_to "Supprimer",
        invoice_path(@invoice),
        data: {
          turbo_method: :delete,
          turbo_confirm: "Supprimer cette facture ?"
        },
        class: "btn btn-danger" %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-7 mb-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <p><strong>Numéro :</strong> <%= @invoice.invoice_number.presence || "N/A" %></p>
          <p><strong>Montant :</strong> $<%= @invoice.amount || 0 %></p>
          <p><strong>Status :</strong> <%= @invoice.status.presence || "pending" %></p>
          <p><strong>Catégorie :</strong> <%= @invoice.category.presence || "N/A" %></p>
          <p><strong>Échéance :</strong> <%= @invoice.due_date || "N/A" %></p>

          <% if @invoice.folders.any? %>
            <p>
              <strong>Dossiers :</strong>
              <%= @invoice.folders.map(&:name).join(", ") %>
            </p>
          <% end %>

          <% if @invoice.ocr_extracted_text.present? %>
            <hr>

            <h5 class="mb-3">OCR extrait</h5>

            <pre class="bg-light p-3 rounded"><%= @invoice.ocr_extracted_text %></pre>
          <% end %>

        </div>
      </div>
    </div>

    <div class="col-lg-5 mb-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Document</h5>

          <% if @invoice.document.attached? %>
            <% if @invoice.document.content_type.start_with?("image/") %>
              <%= image_tag @invoice.document, class: "img-fluid rounded border mb-3" %>
            <% else %>
              <p class="text-muted">Prévisualisation PDF à venir.</p>
            <% end %>

            <%= link_to "Télécharger le document",
              rails_blob_path(@invoice.document, disposition: "attachment"),
              class: "btn btn-outline-primary" %>
          <% else %>
            <p class="text-muted mb-0">Aucun document attaché.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>
