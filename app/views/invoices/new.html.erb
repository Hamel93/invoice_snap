<% content_for :title, "Nouvelle facture" %>

<%= render "shared/screen_header",
      title: "Saisie manuelle",
      subtitle: "Renseignez les informations de votre facture",
      back: camera_invoices_path %>

<div class="app-pad" style="margin-top:18px;">
  <div class="card-soft mb-3 d-flex align-items-center gap-3">
    <div class="folder-card__icon mb-0" style="background:#eceafe;color:#4039d4;">
      <i class="fa-solid fa-keyboard"></i>
    </div>
    <div class="flex-fill">
      <div class="fw-semibold" style="font-size:.88rem;">Sans scanner</div>
      <div class="faint" style="font-size:.74rem;">Vous pouvez aussi joindre un document si besoin.</div>
    </div>
    <%= link_to camera_invoices_path, class: "btn-soft", style: "padding:.55rem .8rem;" do %>
      <i class="fa-solid fa-camera me-1"></i> Scanner
    <% end %>
  </div>

  <%= render "form", invoice: @invoice, folders: @folders %>
</div>
