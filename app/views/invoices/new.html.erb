<% content_for :title, "Analyse du document" %>

<%= render "shared/screen_header", title: "Analyse du document",
      subtitle: "Vérifiez les données extraites par l'OCR", back: camera_invoices_path %>

<div class="app-pad" style="margin-top:18px;">
  <div class="card-soft d-flex align-items-center gap-3">
    <div class="folder-card__icon mb-0" style="background:#eceafe;color:#4039d4;"><i class="fa-solid fa-file-invoice"></i></div>
    <div class="flex-fill">
      <div class="fw-semibold" style="font-size:.86rem;">Nouveau document</div>
      <div class="faint" style="font-size:.74rem;">Importez un fichier et corrigez les champs.</div>
    </div>
    <span class="badge-status paid"><i class="fa-solid fa-circle-check me-1"></i>OCR&nbsp;prêt</span>
  </div>

  <div class="d-flex align-items-center justify-content-between section-gap mb-2">
    <h2 class="section-title">Données extraites</h2>
    <span class="faint" style="font-size:.74rem;">Modifiable</span>
  </div>

  <%= render "form", invoice: @invoice, folders: @folders %>
</div>
