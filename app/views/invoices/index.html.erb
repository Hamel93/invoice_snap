<% content_for :title, "Historique" %>
<% invoices = @invoices.to_a %>
<% total = invoices.sum { |i| i.amount.to_f } %>
<% pending = invoices.select { |i| i.status.to_s.downcase == "pending" }.sum { |i| i.amount.to_f } %>

<header class="app-header app-header--rounded">
  <div class="app-header__bar">
    <h1 class="app-header__title">Historique</h1>
    <div class="app-header__spacer"></div>
    <%= link_to search_invoices_path, class: "app-header__icon" do %><i class="fa-solid fa-magnifying-glass"></i><% end %>
  </div>
  <p class="app-header__sub"><%= pluralize(invoices.size, "document") %> · <%= eur(total) %> au total</p>
</header>

<div class="app-pad" style="margin-top:18px;">
  <div class="chip-row mb-3">
    <span class="chip is-active">Tout</span>
    <span class="chip">Payées</span>
    <span class="chip">En attente</span>
    <span class="chip">En retard</span>
  </div>

  <% if invoices.any? %>
    <div class="mb-3 text-end">
      <%= link_to invoices_path(request.query_parameters.merge(format: :csv)),
                  class: "btn btn-outline-secondary btn-sm" do %>
        <i class="fa-solid fa-file-arrow-down"></i> Exporter en CSV
      <% end %>
    </div>

    <% invoices.each do |invoice| %>
      <%= render "shared/invoice_row", invoice: invoice %>
    <% end %>
  <% else %>
    <div class="empty-state card-soft">
      <i class="fa-solid fa-file-invoice d-block"></i>
      Aucun document dans l'historique.
      <div class="mt-3"><%= link_to "Scanner une facture", camera_invoices_path, class: "btn btn-grad" %></div>
    </div>
  <% end %>
</div>
