<%# locals: invoice:, folders: %>
<%= form_with model: invoice, class: "card-soft", multipart: true, data: { turbo: false } do |f| %>
  <% if invoice.errors.any? %>
    <div class="alert alert-danger py-2" style="font-size:.82rem;border-radius:14px;">
      <%= invoice.errors.full_messages.first %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :company_name, "Client", class: "form-label" %>
    <%= f.text_field :company_name, class: "form-control", placeholder: "Nom du client" %>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-7">
      <%= f.label :invoice_number, "N° de facture", class: "form-label" %>
      <%= f.text_field :invoice_number, class: "form-control font-mono", placeholder: "FA-0000" %>
    </div>
    <div class="col-5">
      <%= f.label :amount, "Montant", class: "form-label" %>
      <%= f.number_field :amount, step: :any, class: "form-control font-mono", placeholder: "0,00" %>
    </div>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-6">
      <%= f.label :due_date, "Échéance", class: "form-label" %>
      <%= f.date_field :due_date, class: "form-control" %>
    </div>
    <div class="col-6">
      <%= f.label :status, "Statut", class: "form-label" %>
      <%= f.select :status,
            options_for_select([["En attente", "pending"], ["Payée", "paid"], ["En retard", "overdue"]], invoice.status),
            { include_blank: "—" }, class: "form-select" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :category, "Catégorie", class: "form-label" %>
    <%= f.text_field :category, class: "form-control", placeholder: "Prestation, fournitures, abonnement…" %>
  </div>

  <% if folders.present? %>
    <div class="mb-3">
      <label class="form-label">Classeurs</label>
      <div class="d-flex flex-wrap gap-2">
        <% folders.each do |folder| %>
          <% checked = invoice.folder_ids.include?(folder.id) %>
          <label class="chip <%= 'is-active' if checked %>" style="cursor:pointer;">
            <%= check_box_tag "invoice[folder_ids][]", folder.id, checked,
                  class: "d-none", id: "folder_#{folder.id}",
                  onchange: "this.closest('.chip').classList.toggle('is-active', this.checked)" %>
            <%= folder.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :document, "Document (PDF, image)", class: "form-label" %>
    <%= f.file_field :document, class: "form-control" %>
  </div>

  <%= f.submit (invoice.persisted? ? "Enregistrer les modifications" : "Enregistrer la facture"),
        class: "btn btn-grad w-100" %>
<% end %>
