<% content_for :title, "Scanner une facture" %>

<%= render "shared/screen_header",
      title: "Scanner une facture",
      subtitle: "Prenez une photo ou importez un document",
      back: dashboard_path %>

<div class="app-pad" style="margin-top:18px;">
  <div class="card-soft text-center">
    <div class="folder-card__icon mx-auto mb-3" style="background:#eceafe;color:#4039d4;">
      <i class="fa-solid fa-camera"></i>
    </div>

    <h2 class="section-title mb-2">Ajouter un document</h2>

    <p class="faint mb-4" style="font-size:.86rem;">
      La caméra native de votre téléphone s’ouvrira si vous choisissez “Prendre une photo”.
    </p>

    <%= form_with model: current_user.invoices.new,
                  url: invoices_path,
                  method: :post,
                  multipart: true,
                  data: { turbo: false },
                  class: "d-grid gap-3" do |f| %>

      <%= f.hidden_field :company_name, value: "Document OCR" %>
      <%= f.hidden_field :status, value: "pending" %>
      <%= f.hidden_field :category, value: "OCR" %>

      <label class="btn btn-grad btn-lg w-100 mb-0">
        <i class="fa-solid fa-camera me-2"></i>
        Prendre une photo
        <%= f.file_field :document,
              accept: "image/*",
              capture: "environment",
              class: "d-none",
              onchange: "this.form.submit();" %>
      </label>

      <label class="btn btn-ghost w-100 mb-0">
        <i class="fa-solid fa-file-arrow-up me-2"></i>
        Choisir un fichier
        <%= f.file_field :document,
              accept: "image/*,.pdf",
              class: "d-none",
              onchange: "this.form.submit();" %>
      </label>
    <% end %>
  </div>

  <div class="card-soft mt-3">
    <h3 class="section-title mb-2">Important</h3>
    <p class="faint mb-0" style="font-size:.82rem;">
      Sur ordinateur, le bouton photo ouvre souvent le sélecteur de fichiers.
      Sur téléphone, il peut ouvrir directement la caméra.
    </p>
  </div>
</div>
