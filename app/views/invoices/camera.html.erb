<% content_for :title, "Scanner une facture" %>

<%= render "shared/screen_header",
      title: "Scanner une facture",
      subtitle: "Prenez une photo ou importez un document",
      back: dashboard_path %>

<div class="app-pad" style="margin-top:18px;">

  <div class="card-soft text-center">

    <h2 class="section-title mb-2">
      Importer une facture
    </h2>

    <p class="faint mb-4" style="font-size:.86rem;">
      Prenez une photo ou sélectionnez un document PDF depuis votre appareil.
    </p>

    <%= form_with model: current_user.invoices.new,
                  url: invoices_path,
                  method: :post,
                  multipart: true,
                  data: { turbo: false },
                  class: "d-grid gap-3" do |f| %>

      <%= f.hidden_field :company_name, value: "Document OCR" %>
      <%= f.hidden_field :status, value: "pending" %>
      <%= f.hidden_field :category, value: "OCR" %>

      <label class="btn btn-grad btn-lg w-100 mb-0">

        <i class="fa-solid fa-camera me-2"></i>

        Ajouter une facture

        <%= f.file_field :document,
              accept: "image/*,.pdf",
              capture: "environment",
              class: "d-none",
              onchange: "this.form.submit();" %>

      </label>

    <% end %>

  </div>

</div>
