<% content_for :title, "Scanner une facture" %>
<% content_for :no_nav, "1" %>

<div class="scanner">
  <div class="scanner__top">
    <%= link_to dashboard_path, class: "scanner__icon-btn", "aria-label": "Fermer" do %>
      <i class="fa-solid fa-xmark"></i>
    <% end %>
    <div style="font-size:.78rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#c9c5fa;">
      Scanner OCR
    </div>
    <%= link_to new_invoice_path, class: "scanner__icon-btn", "aria-label": "Saisie manuelle" do %>
      <i class="fa-solid fa-keyboard"></i>
    <% end %>
  </div>

  <div class="scanner__stage">
    <div class="scanner__frame">
      <span class="tl"></span><span class="tr"></span>
      <span class="bl"></span><span class="br"></span>
    </div>
    <p class="scanner__hint">
      Cadrez votre facture dans le viseur.<br>L'OCR lira automatiquement montants, dates et clients.
    </p>
  </div>

  <div class="scanner__bottom">
    <%= form_with model: current_user.invoices.new,
                  url: invoices_path,
                  method: :post,
                  multipart: true,
                  data: { turbo: false },
                  id: "camera-import-form",
                  class: "d-contents" do |f| %>
      <%= f.hidden_field :company_name, value: "Document OCR" %>
      <%= f.hidden_field :status, value: "pending" %>
      <%= f.hidden_field :category, value: "OCR" %>

      <%# Import (gallery) %>
      <label class="scanner__icon-btn" style="cursor:pointer;" title="Importer depuis la galerie">
        <i class="fa-regular fa-image"></i>
        <%= f.file_field :document,
              accept: "image/*,.pdf",
              class: "d-none",
              id: "import-file",
              onchange: "document.getElementById('camera-import-form').submit();" %>
      </label>
    <% end %>

    <%# Shutter = ouvre la caméra système %>
    <%= form_with model: current_user.invoices.new,
                  url: invoices_path,
                  method: :post,
                  multipart: true,
                  data: { turbo: false },
                  id: "camera-shoot-form",
                  class: "d-contents" do |f| %>
      <%= f.hidden_field :company_name, value: "Document OCR" %>
      <%= f.hidden_field :status, value: "pending" %>
      <%= f.hidden_field :category, value: "OCR" %>

      <label class="scanner__shutter" aria-label="Prendre une photo">
        <%= f.file_field :document,
              accept: "image/*",
              capture: "environment",
              class: "d-none",
              id: "shoot-file",
              onchange: "document.getElementById('camera-shoot-form').submit();" %>
      </label>
    <% end %>

    <%= link_to new_invoice_path, class: "scanner__icon-btn", "aria-label": "Saisie manuelle" do %>
      <i class="fa-solid fa-pen"></i>
    <% end %>
  </div>
</div>
